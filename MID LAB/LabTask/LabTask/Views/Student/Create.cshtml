
@model Student

<h1>Enrollment</h1>

<div asp-validation-summary="All"></div>

<form method="post" action="../Student/Create">
    <label for="Name">Full Name:</label>
    <input type="text" name="Fullname" value="@Model?.Fullname"/>
    <span>@Html.ValidationMessage("Fullname")</span>
    <br /> <br />

    <label for="">Email:</label>
    <input type="email" name="Email"  />
    <span>@Html.ValidationMessage("Email")</span>
    <br /> <br />


    <label for="">Course Code:</label>
    <input type="text" name="CourseCode" />
    <span>@Html.ValidationMessage("CourseCode")</span>
    <br /> <br />


    <label for="">Credit Hour: </label>
    <input type="number" name="CreditHr" max="4" />
    <span>@Html.ValidationMessage("CreditHr")</span>
    <br /> <br />



    <label for="">Semester Fee:</label>
    <input type="number" name="Semfee" min="50000"/>
    <span>@Html.ValidationMessage("Semfee")</span>
    <br /> <br />

    <button type="submit" class="btn btn-primary"> Submit </button>

</form>


    <table class="table">
    <tr>
        <th>Name</th>
        <td>@ViewBag.name</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@ViewBag.email</td>
    </tr>

    <tr>
        <th>Crs Credit</th>
        <td>@ViewBag.crcd</td>
    </tr>

    <tr>
        <th>Crd Hour</th>
        <td>@ViewBag.crh</td>
    </tr>

    <tr>
        <th>Sem Fee</th>
        <td>@ViewBag.semf</td>
    </tr>
</table>
