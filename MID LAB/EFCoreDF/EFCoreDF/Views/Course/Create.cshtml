@model Course
<h1>Create Course</h1>

<form method="post" asp-action="Create">
    <label>Course Name: </label>
    <input asp-for="CourseName" type="text" value="" class="form-control" />

    <label>Course Credit: </label>
    <input asp-for="Credit" type="number" value="" min="1" max="4" class="form-control" />

    <br />
    <input type="submit" class="btn btn-primary"/>
</form>