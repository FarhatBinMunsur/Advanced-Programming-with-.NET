@{
    ViewData["Title"]="Registration";
}

<h1>Registration</h1>

<form method="post">
    <div>
        <label>Name: </label>
        <input type="text" name="name" value="@ViewBag.name" placeholder="Enter name"/>
    </div>

    <div>
        <label>Age: </label>
        <input type="number" name="age" value="@ViewBag.age" placeholder="Enter age"/>
    </div>

    <button type="Submit" class="btn btn-primary">Submit</button>

</form>

<br />
<div>
    <h3>Your Data</h3>
    <h5>Name: @ViewBag.name</h2>
    <h5>Age: @ViewBag.age</h2>
</div>
