@{
    // Layout = null;
}

<div>
    <h1>Here are the User List</h1>

    <div>
        <table class="table">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Address</th>
                <th>Phone</th>
                <th>Action</th>
            </tr>

            @foreach(var users in Model)
            {
                <tr>
                    <td>@users.id</td>
                    <td>@users.name</td>
                    <td>@users.email</td>
                    <td>@users.address</td>
                    <td>@users.phone</td>
                    <td><a href="../users/profile/details/@users.id">Details</a></td>
                </tr>
            }
        </table>
    </div>

    <a asp-controller="User" asp-action="test3">Home</a>



</div>


