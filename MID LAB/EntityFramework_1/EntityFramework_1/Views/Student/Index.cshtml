
<div class="d-flex justify-content-between">
    <h3> Students List</h3>

    <a href="/student/create" class="btn btn-success"> Create Student</a>

</div>
<br />
<br />


<table class="table table-hover ">
    <tr class="table-primary" >
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Cgpa</th>
        <th>Action</th>
    </tr>

    
    @foreach(var student in Model)
    {
        <tr class="table-warning">
        <td>@student.id</td>
        <td>@student.name</td>
        <td>@student.email</td>
        <td>@student.cgpa</td>
        <td>
            <a href="/student/Edit/@student.id" class="btn btn-primary">Update</a>
            <a href="/student/delete/@student.id" class="btn btn-danger">Delete</a>

        </td>
        </tr>
    }
    
</table>

