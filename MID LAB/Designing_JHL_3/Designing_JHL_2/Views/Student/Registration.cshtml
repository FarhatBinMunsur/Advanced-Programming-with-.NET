@{
    ViewData["Title"]="Registration";
    // Layout = "_CustomLayout";
}

<h1>Registration</h1>

<form method="post">
    <div>
        <label>Name: </label>
        <input type="text" name="name" value="@ViewBag.name" placeholder="Enter name"/>
    </div>

    <div>
        <label>Age: </label>
        <input type="number" name="age" value="@ViewBag.age" placeholder="Enter age"/>
    </div>

    <button type="Submit" class="btn btn-primary">Submit</button>

</form>

@section Submenu {
    <p class="fw-bold text-dark">This is Rendersection.Use for Submeu.</p>
}

<br />
